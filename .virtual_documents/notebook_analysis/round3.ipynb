    coeffs = fit_quadratic_smile(fit_snap['moneyness_iv'].to_numpy(), fit_snap['mid_iv'].to_numpy())
    local_coeff_rows.append({'day': day, 'timestamp': ts, 'a_local': coeffs[0], 'b_local': coeffs[1], 'c_local': coeffs[2]})

